<?xml version="1.0"?>
<model>
  <name>bear</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <author>
    <name>Poly by Google (mesh); converted to Collada for Gazebo Fortress</name>
