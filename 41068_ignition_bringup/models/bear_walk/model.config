<?xml version="1.0"?>
<model>
  <name>bear_walk</name>
  <version>1.0</version>
  <sdf version="1.8">model_body.sdf</sdf>
  <description>
    The bear mesh cut into five independent pieces (body + 4 legs) by
    scripts/split_bear.py, so a driver node can swing the legs through a gait.
    The pieces are spawned as inline models in the world, not via model://
    includes; only the meshes here are referenced. Mesh and texture are the
    CC-BY 3.0 Poly bear - see models/bear/ATTRIBUTION.md.
  </description>
</model>
